# cluster-center-mcc(OPIC 集群域 CLC) 环境变量（compose/config 覆盖用；生产部署经 /opt/opic-prod/.env 注入）
# ── 数据面（Pigsty：host.docker.internal=宿主网关，HOST_GW_IP 见生产 .env）──
PG_HOST=host.docker.internal
PG_PORT=5433
DB_NAME=opicdb
DB_SCHEMA=clc              # 集群中心专属 schema(域码 CLC 小写)
# DB_PASSWORD / PG_ADMIN_PASSWORD：口令只在生产 .env，不入库
# ── 中间件（能力中心级隔离，OPIC-TECH-01 v1.1）────────────────────────────────
# CENTER_CODE：中心域码（小写），隔离三件套的根——
#   ① opicdb schema=DB_SCHEMA（opicdb 单实例，每中心一 schema）
#   ② Temporal TaskQueue=WORKFLOW_TASK_QUEUE（clc）
#   ③ NATS stream=NATS_STREAM（clc）+ 主题域=opic.clc.>
CENTER_CODE=clc            # 集群中心域码
EVENTBUS_DRIVER=nats        # inproc|nats
EVENTBUS_URL=nats://opic-nats:4222
NATS_STREAM=clc             # NATS 流名(与 Temporal 队列同名)
NATS_SUBJECT_PREFIX=opic.clc.
WORKFLOW_DRIVER=temporal    # local|temporal
WORKFLOW_ADDRESS=temporal:7233
WORKFLOW_NAMESPACE=opic
WORKFLOW_TASK_QUEUE=clc     # Temporal 任务队列
REDIS_ENABLED=true
REDIS_HOST=opic-redis
# REDIS_PASSWORD / NATS_PASSWORD：见生产 .env
# ── 认证 ──
AUTH_MODE=local            # local|zitadel
ZITADEL_ISSUER=https://auth.opic-ai.ccoe.tech
# JWT_SECRET：见生产 apps/cluster-center-mcc/.env
# ── 交付执行内核（v1.1 真实交付链路，本地/远程两条链路的可用性即由这几项决定，REF-16）──
# 未配置对应链路 ⇒ 该执行位置不可登记，提交即拒绝（INV-46），不会排队后失联
DELIVERY_TOOL_BIN=/opt/opic/delivery/bin/delivery-tool   # 本地链路：交付工具可执行文件路径
DELIVERY_TOOL_DIR=/opt/opic/delivery                     # 本地链路：交付工具工作目录（容器挂载点）
# DELIVERY_KUBECONFIG_ENV / DELIVERY_KUBECONFIG_PATH_PATTERN：见 configs/config.yml（一般无需覆盖）
IGNITION_BASE_URL=http://opic-ign-app:9680             # 远程链路：点火中心地址（opic-net 内直连；空 ⇒ 不可登记 REMOTE_EXECUTOR）
# IGNITION_TOKEN：点火中心交付门面服务令牌（对端 delivery.facade_token），只在生产 .env，不入库
# ── 入口 ──
BASE_DOMAIN=opic-ai.ccoe.tech
TRAEFIK_ENTRYPOINT=websecure
HOST_GW_IP=172.20.0.1
