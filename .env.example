# opic-techbase 环境变量(docker compose / 容器部署用;本地 dev 用 configs/config.yml)
# 复制为 .env:cp .env.example .env

# ---- 网关 ----
GATEWAY_PORT=8000

# ---- 数据库(数据栈 + 应用栈共用) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=go_techbase
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- 应用(12-factor 覆盖 config.yml) ----
APP_PORT=9680
JWT_SECRET=go-techbase-dev-secret
METRICS_ENABLED=true
AUTH_MODE=local
# ZITADEL(mode=zitadel 时必填)
# ZITADEL_ISSUER=http://zitadel:8080
# ZITADEL_CLIENT_ID=go-techbase
# ZITADEL_CLIENT_SECRET=
# ZITADEL_REDIRECT_URL=http://localhost:8000/api/auth/callback

# ---- 镜像 ----
IMAGE_PREFIX=opic
IMAGE_TAG=latest
